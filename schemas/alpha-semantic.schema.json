{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bilqis:alpha:semantic-schema:0.1.0",
  "title": "Alpha projection; runtime additionally validates binding/depth/canonicality",
  "type": "object",
  "properties": {
    "abi": {
      "const": "bilqis-alpha-cogal-0.1.0"
    },
    "world": {
      "$ref": "#/$defs/world"
    },
    "query": {
      "$ref": "#/$defs/query"
    }
  },
  "required": [
    "abi",
    "world",
    "query"
  ],
  "additionalProperties": false,
  "$defs": {
    "term": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "constant"
            },
            "id": {
              "enum": [
                "urn:bilqis:alpha:cogal:a",
                "urn:bilqis:alpha:cogal:b"
              ]
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "variable"
            },
            "id": {
              "const": "urn:bilqis:alpha:cogal:x"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "query": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "urn:bilqis:alpha:cogal:relation",
                "urn:bilqis:alpha:cogal:equal"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/term"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "urn:bilqis:alpha:cogal:not"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/query"
              },
              "minItems": 1,
              "maxItems": 1
            }
          },
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "urn:bilqis:alpha:cogal:and",
                "urn:bilqis:alpha:cogal:or"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/query"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "urn:bilqis:alpha:cogal:exists",
                "urn:bilqis:alpha:cogal:forall"
              ]
            },
            "variable": {
              "const": "urn:bilqis:alpha:cogal:x"
            },
            "body": {
              "$ref": "#/$defs/query"
            }
          },
          "required": [
            "op",
            "variable",
            "body"
          ],
          "additionalProperties": false
        }
      ]
    },
    "fact": {
      "type": "object",
      "properties": {
        "predicate": {
          "const": "urn:bilqis:alpha:cogal:relation"
        },
        "roles": {
          "type": "object",
          "properties": {
            "source": {
              "enum": [
                "urn:bilqis:alpha:cogal:a",
                "urn:bilqis:alpha:cogal:b"
              ]
            },
            "target": {
              "enum": [
                "urn:bilqis:alpha:cogal:a",
                "urn:bilqis:alpha:cogal:b"
              ]
            }
          },
          "required": [
            "source",
            "target"
          ],
          "additionalProperties": false
        },
        "polarity": {
          "enum": [
            "urn:bilqis:alpha:cogal:support",
            "urn:bilqis:alpha:cogal:refute"
          ]
        },
        "source": {
          "enum": [
            "urn:bilqis:alpha:cogal:source-0",
            "urn:bilqis:alpha:cogal:source-1"
          ]
        }
      },
      "required": [
        "predicate",
        "roles",
        "polarity",
        "source"
      ],
      "additionalProperties": false
    },
    "world": {
      "type": "object",
      "properties": {
        "entities": {
          "const": [
            "urn:bilqis:alpha:cogal:a",
            "urn:bilqis:alpha:cogal:b"
          ]
        },
        "sources": {
          "const": [
            "urn:bilqis:alpha:cogal:source-0",
            "urn:bilqis:alpha:cogal:source-1"
          ]
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "entities",
        "sources",
        "facts"
      ],
      "additionalProperties": false
    }
  }
}
