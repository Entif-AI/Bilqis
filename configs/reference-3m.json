{
  "schema_version": "bilqis-reference-config-0.1.0",
  "run_class": "ENGINEERING",
  "profile": "reference-3m",
  "seed": 101,
  "representation": "bilqis",
  "teacher_policy": "topology",
  "model": {
    "vocab_size": 512,
    "context": 384,
    "width": 192,
