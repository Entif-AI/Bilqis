    "eps": 1e-08,
    "weight_decay": 0.1,
    "clip_norm": 1.0
  },
  "thresholds": {
    "mastery_lower": 0.9,
    "retention_lower": 0.85,
    "dev_transfer_accuracy": 0.75
  }
}
